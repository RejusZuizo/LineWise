<Project>

  <!-- Central package management. Every version lives here, once. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Label="Printing">
    <PackageVersion Include="QuestPDF" Version="2024.12.3" />
  </ItemGroup>

  <ItemGroup Label="Import">
    <!-- MIT licensed. EPPlus is not, and is unusable in a product that will be sold. -->
    <PackageVersion Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <!-- Sqlite.Core rather than Sqlite, so the unencrypted SQLite bundle is not dragged in
         alongside the SQLCipher one. Exactly one bundle may be loaded. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="8.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="User interface">
    <!--
      Avalonia 11, not 12, and FluentAvalonia 2.4.0, not 2.5.1 or 3.x. Every FluentAvalonia
      release after 2.4.0 targets net10.0 only, and this product targets net8.0. Pinning
      here is deliberate: the alternatives were dropping the control set the design document
      chose, or turning a UI decision into a framework migration before the UI exists.

      The consequence is that FluentAvalonia stops receiving fixes here until the target
      framework moves. Dependabot ignores major NuGet bumps, so it will not keep proposing
      the versions that cannot be taken.
    -->
    <PackageVersion Include="Avalonia" Version="11.3.20" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.20" />
    <!-- Inter, embedded rather than fetched. See ADR 0013: this reverses the design
         document's "system font" rule deliberately, and embedding is what keeps it a
         reversal about typography rather than about making a network call. -->
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageVersion Include="FluentAvaloniaUI" Version="2.4.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Coverage is measured and reported, never gated. A threshold on a solo project
         produces tests written to satisfy the threshold. -->
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

</Project>
