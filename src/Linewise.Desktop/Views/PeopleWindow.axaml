<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Linewise.Desktop.ViewModels"
        xmlns:res="using:Linewise.Desktop.Resources"
        xmlns:views="using:Linewise.Desktop.Views"
        xmlns:entities="using:Linewise.Domain.Entities"
        mc:Ignorable="d"
        d:DesignWidth="980" d:DesignHeight="680"
        x:Class="Linewise.Desktop.Views.PeopleWindow"
        x:DataType="vm:PeopleViewModel"
        Title="{x:Static res:Strings.People}"
        Width="980" Height="680"
        MinWidth="820" MinHeight="560"
        Background="{DynamicResource LinewiseSurfaceAlt}"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="Border.ruleRow">
      <Setter Property="Background" Value="{DynamicResource LinewiseSurfaceAlt}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- The first choice is the one that decides most rosters, so it is the one the eye
         finds. A border rather than a colour: the rest of this screen is already carrying
         the line accents. -->
    <Style Selector="Border.ruleRow.first">
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseBorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True" Margin="16">

    <TextBlock DockPanel.Dock="Top"
               Text="{x:Static res:Strings.People}"
               Classes="title"
               Margin="0,0,0,12" />

    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,12,0,0">
      <TextBlock DockPanel.Dock="Left"
                 Text="{Binding Status}"
                 Classes="subtitle"
                 VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right"
              Content="{x:Static res:Strings.Close}"
              Classes="quiet"
              Click="OnClose"
              Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right"
              Content="{x:Static res:Strings.CheckRules}"
              Classes="quiet"
              Command="{Binding CheckRulesCommand}"
              Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right"
              Content="{x:Static res:Strings.SaveRules}"
              Classes="primary"
              Command="{Binding SaveCommand}"
              IsEnabled="{Binding HasSelection}" />
    </DockPanel>

    <Border DockPanel.Dock="Bottom"
            Classes="card"
            IsVisible="{Binding HasImpossibilities}"
            Padding="12"
            Margin="0,12,0,0">
      <StackPanel Spacing="6">
        <TextBlock Text="{x:Static res:Strings.RulesImpossibleHeading}" Classes="sectionHeading" />
        <ItemsControl ItemsSource="{Binding Impossibilities}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Bottom"
               Text="{x:Static res:Strings.RulesPossible}"
               Classes="subtitle"
               IsVisible="{Binding IsPossible}"
               Margin="0,12,0,0" />

    <!-- The list, grouped by what each person is permitted to be. Sixty names in one flat
         column is a wall; "who can lead Ovens" is what this screen is opened to answer.

         A tree rather than a list of lists, so selection is one thing across every group
         and a heading can be collapsed without taking the selection with it. -->
    <Border DockPanel.Dock="Left"
            Width="290"
            Background="{DynamicResource LinewiseSurface}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="0,0,12,0">
      <DockPanel LastChildFill="True">
        <TextBox DockPanel.Dock="Top"
                 Text="{Binding Search}"
                 Watermark="{x:Static res:Strings.PeopleSearch}"
                 Margin="10" />

        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding CapabilityBreakdown}"
                   Classes="caption"
                   TextWrapping="Wrap"
                   Margin="10,8,10,10" />

        <TreeView ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                  Background="Transparent"
                  BorderThickness="0">

          <!-- Open on arrival. A screen that opens with every group shut makes somebody
               click three times to see what they came for.

               A setter rather than a binding: whether a heading is open is a property of
               the screen and nothing else reads it, and a click still collapses the group
               because a local value outranks one set by a theme. -->
          <TreeView.ItemContainerTheme>
            <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
              <Setter Property="IsExpanded" Value="True" />
            </ControlTheme>
          </TreeView.ItemContainerTheme>
          <TreeView.DataTemplates>

            <TreeDataTemplate DataType="vm:PeopleGroupViewModel" ItemsSource="{Binding People}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                <TextBlock Text="{Binding CountLabel}" Classes="caption" VerticalAlignment="Center" />
              </StackPanel>
            </TreeDataTemplate>

            <DataTemplate DataType="vm:EmployeeViewModel">
              <StackPanel Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" FontSize="13" />
                  <!-- Agency staff are marked rather than grouped apart. A temporary worker
                       who can lead is exactly who is wanted when a line loses its leader. -->
                  <TextBlock Text="{x:Static res:Strings.PeopleTemporary}"
                             Classes="caption"
                             IsVisible="{Binding IsTemporary}"
                             VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Classes="caption" />
              </StackPanel>
            </DataTemplate>

          </TreeView.DataTemplates>
        </TreeView>
      </DockPanel>
    </Border>

    <Border Background="{DynamicResource LinewiseSurface}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="1"
            CornerRadius="6"
            IsVisible="{Binding HasSelection}">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Selected.Name}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="14,12,14,8" />

        <ScrollViewer>
          <StackPanel Margin="14,0,14,14" Spacing="8">

            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left"
                         Text="{x:Static res:Strings.PeopleWorksHeading}"
                         Classes="sectionHeading"
                         VerticalAlignment="Center" />
              <Button DockPanel.Dock="Right"
                      Content="{x:Static res:Strings.PeopleAddWorked}"
                      Classes="quiet"
                      IsEnabled="{Binding Selected.HasAddable}">
                <Button.Flyout>
                  <!-- A list of buttons rather than a MenuFlyout. A MenuFlyout puts the item
                       itself in MenuItem.Header and never applies the item template to it,
                       so a record renders through ToString() and the operator is shown an
                       identifier and every other property alongside the name. -->
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <ItemsControl ItemsSource="{Binding Selected.Addable}" MinWidth="180">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="entities:ProductionLine">
                          <Button Classes="quiet"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Command="{Binding $parent[Window].((vm:PeopleViewModel)DataContext).Selected.AddWorkedCommand}"
                                  CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Border Width="3" CornerRadius="2" Background="{Binding AccentColour}" />
                              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </DockPanel>

            <TextBlock Text="{x:Static res:Strings.PeopleDragHint}"
                       Classes="caption"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Selected.HasWorks}" />

            <TextBlock Text="{x:Static res:Strings.PeopleWorksNone}"
                       Classes="caption"
                       TextWrapping="Wrap"
                       IsVisible="{Binding !Selected.HasWorks}" />

            <!-- Order is the priority. Nothing here stores a rank, so two lines cannot
                 claim the same one and the screen cannot disagree with what is saved. -->
            <ItemsControl ItemsSource="{Binding Selected.Works}"
                          views:Reorderable.AllowDrag="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:EmployeeLineRuleViewModel">
                  <Border Classes="ruleRow" Classes.first="{Binding IsFirst}">
                    <DockPanel LastChildFill="True">

                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                        <!-- The keyboard route to what dragging does. A drag is a gesture
                             somebody has to discover and cannot perform without a mouse. -->
                        <Button Content="↑"
                                Classes="quiet"
                                Padding="8,2"
                                ToolTip.Tip="{x:Static res:Strings.PeopleMoveUp}"
                                IsEnabled="{Binding !IsFirst}"
                                Command="{Binding MoveUpCommand}" />
                        <Button Content="↓"
                                Classes="quiet"
                                Padding="8,2"
                                ToolTip.Tip="{x:Static res:Strings.PeopleMoveDown}"
                                IsEnabled="{Binding !IsLast}"
                                Command="{Binding MoveDownCommand}" />
                        <Button Content="✕"
                                Classes="quiet"
                                Padding="8,2"
                                ToolTip.Tip="{x:Static res:Strings.PeopleRemoveLine}"
                                Command="{Binding RemoveCommand}" />
                      </StackPanel>

                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Width="3" CornerRadius="2" Background="{Binding AccentColour}" />

                          <!-- The only place a drag may start. Anywhere else on the row is a
                               click on the way to a checkbox, and an accidental drag holds a
                               pointer grab for as long as it runs. -->
                          <TextBlock Text="⠿"
                                     views:Reorderable.IsHandle="True"
                                     Classes="caption"
                                     FontSize="14"
                                     Cursor="Hand"
                                     ToolTip.Tip="{x:Static res:Strings.PeopleDragHandle}"
                                     VerticalAlignment="Center" />

                          <TextBlock Text="{Binding LineName}"
                                     FontWeight="SemiBold"
                                     FontSize="13"
                                     VerticalAlignment="Center" />
                          <TextBlock Text="{Binding PositionLabel}"
                                     Classes="caption"
                                     VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="14">
                          <CheckBox Content="{x:Static res:Strings.PeopleMustWork}"
                                    IsChecked="{Binding IsMandatory, Mode=TwoWay}" />
                          <CheckBox Content="{x:Static res:Strings.PeopleCanLead}"
                                    IsChecked="{Binding CanLead, Mode=TwoWay}" />
                          <CheckBox Content="{x:Static res:Strings.PeopleCanAssist}"
                                    IsChecked="{Binding CanAssist, Mode=TwoWay}" />
                        </StackPanel>
                      </StackPanel>

                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel LastChildFill="False" Margin="0,8,0,0">
              <TextBlock DockPanel.Dock="Left"
                         Text="{x:Static res:Strings.PeopleBlockedHeading}"
                         Classes="sectionHeading"
                         VerticalAlignment="Center" />
              <Button DockPanel.Dock="Right"
                      Content="{x:Static res:Strings.PeopleAddBlocked}"
                      Classes="quiet"
                      IsEnabled="{Binding Selected.HasAddable}">
                <Button.Flyout>
                  <!-- A list of buttons rather than a MenuFlyout. A MenuFlyout puts the item
                       itself in MenuItem.Header and never applies the item template to it,
                       so a record renders through ToString() and the operator is shown an
                       identifier and every other property alongside the name. -->
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <ItemsControl ItemsSource="{Binding Selected.Addable}" MinWidth="180">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="entities:ProductionLine">
                          <Button Classes="quiet"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Command="{Binding $parent[Window].((vm:PeopleViewModel)DataContext).Selected.AddBlockedCommand}"
                                  CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Border Width="3" CornerRadius="2" Background="{Binding AccentColour}" />
                              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </DockPanel>

            <TextBlock Text="{x:Static res:Strings.PeopleBlockedNone}"
                       Classes="caption"
                       IsVisible="{Binding !Selected.HasBlocked}" />

            <!-- Not orderable. A refusal has no priority, and letting one be dragged into a
                 position would imply it had one. -->
            <ItemsControl ItemsSource="{Binding Selected.Blocked}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:EmployeeLineRuleViewModel">
                  <Border Classes="ruleRow">
                    <DockPanel LastChildFill="True">
                      <Button DockPanel.Dock="Right"
                              Content="✕"
                              Classes="quiet"
                              Padding="8,2"
                              ToolTip.Tip="{x:Static res:Strings.PeopleRemoveLine}"
                              Command="{Binding RemoveCommand}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="3" CornerRadius="2" Background="{Binding AccentColour}" />
                        <TextBlock Text="{Binding LineName}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

  </DockPanel>
</Window>
