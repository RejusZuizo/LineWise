<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Linewise.Desktop.ViewModels"
        xmlns:res="using:Linewise.Desktop.Resources"
        mc:Ignorable="d"
        d:DesignWidth="900" d:DesignHeight="640"
        x:Class="Linewise.Desktop.Views.PeopleWindow"
        x:DataType="vm:PeopleViewModel"
        Title="{x:Static res:Strings.People}"
        Width="900" Height="640"
        MinWidth="760" MinHeight="520"
        Background="{DynamicResource LinewiseSurfaceAlt}"
        WindowStartupLocation="CenterOwner">

  <DockPanel LastChildFill="True" Margin="16">

    <TextBlock DockPanel.Dock="Top"
               Text="{x:Static res:Strings.People}"
               Classes="title"
               Margin="0,0,0,12" />

    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,12,0,0">
      <TextBlock DockPanel.Dock="Left"
                 Text="{Binding Status}"
                 Classes="subtitle"
                 VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right"
              Content="{x:Static res:Strings.Close}"
              Classes="quiet"
              Click="OnClose"
              Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right"
              Content="{x:Static res:Strings.CheckRules}"
              Classes="quiet"
              Command="{Binding CheckRulesCommand}"
              Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right"
              Content="{x:Static res:Strings.SaveRules}"
              Classes="primary"
              Command="{Binding SaveCommand}"
              IsEnabled="{Binding HasSelection}" />
    </DockPanel>

    <Border DockPanel.Dock="Bottom"
            Classes="card"
            IsVisible="{Binding HasImpossibilities}"
            Padding="12"
            Margin="0,12,0,0">
      <StackPanel Spacing="6">
        <TextBlock Text="{x:Static res:Strings.RulesImpossibleHeading}" Classes="sectionHeading" />
        <ItemsControl ItemsSource="{Binding Impossibilities}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Bottom"
               Text="{x:Static res:Strings.RulesPossible}"
               Classes="subtitle"
               IsVisible="{Binding IsPossible}"
               Margin="0,12,0,0" />

    <!-- The list. Filtered rather than paged: a hundred and fifty people is a long list
         and a short search, and somebody looking for one person knows their name. -->
    <Border DockPanel.Dock="Left"
            Width="260"
            Background="{DynamicResource LinewiseSurface}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="0,0,12,0">
      <DockPanel LastChildFill="True">
        <TextBox DockPanel.Dock="Top"
                 Text="{Binding Search}"
                 Watermark="{x:Static res:Strings.PeopleSearch}"
                 Margin="10" />
        <TextBlock Text="{x:Static res:Strings.PeopleNobody}"
                   Classes="subtitle"
                   TextWrapping="Wrap"
                   Margin="10,0,10,10"
                   IsVisible="{Binding !HasSelection}" />
        <ListBox ItemsSource="{Binding Visible}"
                 SelectedItem="{Binding Selected}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EmployeeViewModel">
              <StackPanel Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" FontSize="13" />
                  <TextBlock Text="{x:Static res:Strings.PeopleTemporary}"
                             Classes="caption"
                             IsVisible="{Binding IsTemporary}"
                             VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Classes="caption" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- One row per line, whether or not a rule exists for it. A list showing only the
         lines somebody has already had an opinion about is the shape that makes an unset
         preference invisible. -->
    <Border Background="{DynamicResource LinewiseSurface}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="1"
            CornerRadius="6"
            IsVisible="{Binding HasSelection}">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Selected.Name}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="14,12,14,8" />

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Selected.Lines}" Margin="14,0,14,14">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EmployeeLineRuleViewModel">
                <Border Background="{DynamicResource LinewiseSurfaceAlt}"
                        CornerRadius="{StaticResource RadiusSm}"
                        Padding="10"
                        Margin="0,0,0,6">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="3" CornerRadius="2" Background="{Binding AccentColour}" />
                      <TextBlock Text="{Binding LineName}"
                                 FontWeight="SemiBold"
                                 FontSize="13"
                                 VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <!-- No opinion is a real answer and has to be selectable, or every
                           person acquires a rule about every line.

                           GroupName is the line's identifier, so the four buttons on one
                           row are a group and the rows do not interfere with each other.
                           Bound two way to settable properties: the radio drives the value
                           through its own binding rather than through a command beside it. -->
                      <RadioButton Content="{x:Static res:Strings.PeopleNone}"
                                   GroupName="{Binding LineId, StringFormat='pref-{0}'}"
                                   IsChecked="{Binding IsNoPreference, Mode=TwoWay}" />
                      <RadioButton Content="{x:Static res:Strings.PeoplePreferred}"
                                   GroupName="{Binding LineId, StringFormat='pref-{0}'}"
                                   IsChecked="{Binding IsPreferred, Mode=TwoWay}" />
                      <RadioButton Content="{x:Static res:Strings.PeopleMandatory}"
                                   GroupName="{Binding LineId, StringFormat='pref-{0}'}"
                                   IsChecked="{Binding IsMandatory, Mode=TwoWay}" />
                      <RadioButton Content="{x:Static res:Strings.PeopleBlocked}"
                                   GroupName="{Binding LineId, StringFormat='pref-{0}'}"
                                   IsChecked="{Binding IsBlocked, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="6"
                                  IsVisible="{Binding IsRankRelevant}">
                        <TextBlock Text="{x:Static res:Strings.PeopleRank}"
                                   Classes="caption"
                                   VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding Rank}"
                                       Minimum="1"
                                       Maximum="20"
                                       Increment="1"
                                       FormatString="0"
                                       Width="100" />
                      </StackPanel>
                      <CheckBox Content="{x:Static res:Strings.PeopleCanLead}"
                                IsChecked="{Binding CanLead}"
                                IsEnabled="{Binding !IsBlocked}" />
                      <CheckBox Content="{x:Static res:Strings.PeopleCanAssist}"
                                IsChecked="{Binding CanAssist}"
                                IsEnabled="{Binding !IsBlocked}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

  </DockPanel>

</Window>
