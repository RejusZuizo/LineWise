<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Linewise.Desktop.ViewModels"
             xmlns:res="using:Linewise.Desktop.Resources"
             xmlns:enums="using:Linewise.Domain.Enums"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="Linewise.Desktop.Views.RosterGridView"
             x:DataType="vm:RosterGridViewModel">

  <UserControl.Styles>

    <!-- Column headers. Sticky at the top of the grid, because a manager scrolling to
         Chilled prep should not have to remember which column is Thursday. -->
    <Style Selector="Border.dayHeader">
      <Setter Property="Background" Value="{DynamicResource LinewiseSurfaceSunken}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseBorder}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- Cells. The border carries the grid; a short cell thickens it and the numbers say so
         in words. Neither is the only signal, which is the rule that survives a colour
         vision deficiency and a monochrome screenshot alike. -->
    <Style Selector="Border.cell">
      <Setter Property="Background" Value="{DynamicResource LinewiseSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseBorderSubtle}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="MinHeight" Value="64" />
    </Style>

    <Style Selector="Border.cell.short">
      <Setter Property="Background" Value="{DynamicResource LinewiseSurfaceSunken}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseBorderStrong}" />
      <Setter Property="BorderThickness" Value="0,0,2,2" />
    </Style>

    <!-- People. A pill rather than a bare line of text: at a glance the eye counts shapes,
         and counting is what this grid is read for. -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource LinewiseChip}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!--
      A rank gets a colour and a word and a shape, never a colour alone. Leader is the
      strongest mark because it is the one somebody looks for first; assistant sits between
      that and a line worker, which is exactly where it sits on the line.
    -->
    <Style Selector="Border.chip.leader">
      <Setter Property="Background" Value="{DynamicResource LinewiseLeaderFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseLeaderInk}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="Border.chip.leader TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LinewiseLeaderInk}" />
    </Style>

    <Style Selector="Border.chip.assistant">
      <Setter Property="Background" Value="{DynamicResource LinewiseAssistantFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseAssistantInk}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.chip.assistant TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LinewiseAssistantInk}" />
    </Style>

    <!--
      Absent. Last, so it wins over a rank: somebody who is not coming in is not the line
      leader today, whatever the roster says, and the chip has to read that way at a
      glance.

      Three channels, none of them colour on its own: the word ABSENT, a strikethrough
      through the name, and a hollow chip where every other chip is filled. Any one of them
      surviving is enough to tell the two states apart.
    -->
    <Style Selector="Border.chip.absent">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseInkFaint}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.chip.absent TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LinewiseInkFaint}" />
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>

    <!-- The word itself is not struck through. A label nobody can read is not a label. -->
    <Style Selector="Border.chip.absent TextBlock.absentMark">
      <Setter Property="TextDecorations" Value="{x:Null}" />
    </Style>

    <!-- A closed line. Hatched by being sunken and faint, and labelled in words, because a
         cell that merely went empty would read as a line nobody could be found for. -->
    <Style Selector="Border.cell.closed">
      <Setter Property="Background" Value="{DynamicResource LinewiseSurfaceSunken}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseBorder}" />
    </Style>

    <Style Selector="Border.cell.closed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource LinewiseInkFaint}" />
    </Style>

    <Style Selector="Border.headcount">
      <Setter Property="Background" Value="{DynamicResource LinewiseChip}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="Border.headcount.short">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseInk}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.headcount.short > TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Styles>

  <DockPanel LastChildFill="True" Margin="16">

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource LinewiseSurfaceRaised}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="1,1,1,0"
            CornerRadius="6,6,0,0"
            Padding="16,12">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Text="{Binding WeekLabel}" Classes="title" VerticalAlignment="Center" />

        <!-- Today or the week. The same roster either way; only how much of it is on
             screen changes, which is why the buttons live on the grid rather than in the
             navigation beside things that load. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Content="{x:Static res:Strings.ViewToday}"
                  Classes="quiet"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowTodayCommand}" />
          <Button Content="{x:Static res:Strings.ViewWholeWeek}"
                  Classes="quiet"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowWholeWeekCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Background="{DynamicResource LinewiseSurface}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,6,6"
            ClipToBounds="True">
      <DockPanel LastChildFill="True">

        <!-- Header row, outside the scroller so it stays put. -->
        <DockPanel DockPanel.Dock="Top" LastChildFill="True">
          <Border DockPanel.Dock="Left"
                  Width="{StaticResource LineColumnWidth}"
                  Background="{DynamicResource LinewiseSurfaceSunken}"
                  BorderBrush="{DynamicResource LinewiseBorder}"
                  BorderThickness="0,0,1,1"
                  Padding="12,8">
            <TextBlock Text="{x:Static res:Strings.LinesColumnHeading}" Classes="sectionHeading" />
          </Border>
          <ItemsControl ItemsSource="{Binding Dates}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="dayHeader">
                  <StackPanel>
                    <TextBlock Text="{Binding StringFormat='{}{0:ddd}'}"
                               FontWeight="SemiBold"
                               FontSize="13" />
                    <TextBlock Text="{Binding StringFormat='{}{0:d MMM}'}" Classes="caption" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LineRowViewModel">
                <DockPanel LastChildFill="True">

                  <!-- Row header. The line's one saturated colour runs the full height of
                       the row, beside its name and never instead of it. -->
                  <Border DockPanel.Dock="Left"
                          Width="{StaticResource LineColumnWidth}"
                          Background="{DynamicResource LinewiseSurfaceAlt}"
                          BorderBrush="{DynamicResource LinewiseBorder}"
                          BorderThickness="0,0,1,1">
                    <DockPanel LastChildFill="True">
                      <Border DockPanel.Dock="Left" Width="4" Background="{Binding AccentColour}" />
                      <StackPanel Margin="10,9" Spacing="3">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="13.5"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding NeedsLabel}" Classes="caption" />
                        <Border Classes="headcount"
                                Classes.short="True"
                                IsVisible="{Binding IsShortAnyDay}"
                                Margin="0,2,0,0">
                          <TextBlock Text="{Binding ShortLabel}" FontSize="10.5" />
                        </Border>
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RosterCellViewModel">
                        <Border Classes="cell"
                                Classes.short="{Binding IsShort}"
                                Classes.closed="{Binding IsClosed}">
                          <DockPanel LastChildFill="True">

                            <!-- The count sits at the bottom, in the same place in every
                                 cell, so a row can be scanned for shortfalls without
                                 reading any names. -->
                            <StackPanel DockPanel.Dock="Bottom"
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        Margin="0,6,0,0">
                              <Border Classes="headcount" Classes.short="{Binding IsShort}">
                                <TextBlock Text="{Binding Headcount}" FontSize="10.5" />
                              </Border>

                              <!-- Beside the count, not instead of it. "5 of 6" and "1
                                   absent" are two different facts and the manager acts on
                                   both. -->
                              <TextBlock Text="{Binding AbsentLabel}"
                                         Classes="caption"
                                         FontSize="10"
                                         IsVisible="{Binding HasAbsences}"
                                         VerticalAlignment="Center" />

                              <!-- A button rather than a right click. The context menu on a
                                   chip is still unproven on this machine, and shutting a
                                   line is not something to hide behind a gesture nobody can
                                   confirm works. -->
                              <Button Content="{Binding ToggleClosedLabel}"
                                      Classes="quiet"
                                      FontSize="9.5"
                                      Padding="5,0"
                                      Command="{Binding ToggleClosedCommand}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding People}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PersonChipViewModel">
                                  <Border Classes="chip"
                                          Classes.leader="{Binding IsLeader}"
                                          Classes.assistant="{Binding IsOperatingAssistant}"
                                          Classes.absent="{Binding IsAbsent}"
                                          Margin="0,0,0,3"
                                          ToolTip.Tip="{Binding Explanation}">

                                    <!-- Right click, because the grid is read far more
                                         often than it is edited and a row of buttons on
                                         every chip would cost the density the whole layout
                                         is built around.

                                         The menu inherits this chip as its data context,
                                         so its commands are the chip's own. Reaching up
                                         the tree for the window's would mean binding into
                                         a popup, which works until it silently does not. -->
                                    <Border.ContextMenu>
                                      <ContextMenu>
                                        <MenuItem Header="{x:Static res:Strings.MarkAbsent}"
                                                  IsVisible="{Binding !IsAbsent}">
                                          <MenuItem Header="{x:Static res:Strings.AbsenceNotInToday}"
                                                    Command="{Binding MarkAbsentCommand}"
                                                    CommandParameter="{x:Static enums:AbsenceReason.NotInToday}" />
                                          <MenuItem Header="{x:Static res:Strings.AbsenceHoliday}"
                                                    Command="{Binding MarkAbsentCommand}"
                                                    CommandParameter="{x:Static enums:AbsenceReason.Holiday}" />
                                          <MenuItem Header="{x:Static res:Strings.AbsenceSentHome}"
                                                    Command="{Binding MarkAbsentCommand}"
                                                    CommandParameter="{x:Static enums:AbsenceReason.SentHome}" />
                                        </MenuItem>
                                        <MenuItem Header="{x:Static res:Strings.MarkBackIn}"
                                                  IsVisible="{Binding IsAbsent}"
                                                  Command="{Binding ClearAbsenceCommand}" />
                                      </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel Orientation="Horizontal" Spacing="5" >
                                      <!-- Wrapped, not trimmed. A truncated name is worse
                                           than a taller row: the roster exists to tell
                                           somebody who is on the line, and "Person 12 Fic…"
                                           does not. -->
                                      <TextBlock Text="{Binding DisplayName}"
                                                 FontSize="12"
                                                 FontWeight="{Binding IsRanked, Converter={x:Static vm:Converters.BoldWhenTrue}}"
                                                 TextWrapping="Wrap" />
                                      <TextBlock Text="{Binding RoleLabel}"
                                                 FontSize="9.5"
                                                 FontWeight="Bold"
                                                 IsVisible="{Binding IsRanked}"
                                                 VerticalAlignment="Center" />
                                      <TextBlock Text="{Binding AbsenceLabel}"
                                                 Classes="absentMark"
                                                 FontSize="9.5"
                                                 FontWeight="Bold"
                                                 IsVisible="{Binding IsAbsent}"
                                                 VerticalAlignment="Center" />
                                      <TextBlock Text="{x:Static res:Strings.ChipEdited}"
                                                 Classes="caption"
                                                 FontSize="9.5"
                                                 IsVisible="{Binding IsManual}"
                                                 VerticalAlignment="Center" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </DockPanel>
    </Border>

  </DockPanel>

</UserControl>
