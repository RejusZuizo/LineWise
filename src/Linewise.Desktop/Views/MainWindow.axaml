<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Linewise.Desktop.ViewModels"
        xmlns:views="using:Linewise.Desktop.Views"
        xmlns:res="using:Linewise.Desktop.Resources"
        mc:Ignorable="d"
        d:DesignWidth="1360" d:DesignHeight="820"
        x:Class="Linewise.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1360" Height="820"
        MinWidth="960" MinHeight="620"
        Background="{DynamicResource LinewiseSurfaceAlt}"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- Severity is carried by the word inside the badge. The border weight only makes an
         error findable at a glance; it is never the thing that says which it is. -->
    <Style Selector="Border.severity">
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseBorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="Border.severity.error">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseInk}" />
    </Style>

    <Style Selector="Border.severity.error > TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource LinewiseSurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!--
      Navigation down the side rather than a row of buttons across the top. A row gives
      every action the same weight and no grouping, so "generate this week" and "configure
      the factory" sit beside each other looking equally routine. Down the side there is
      room to separate what you do weekly from what you set up once, and room for the lines
      themselves, which are the thing a first run has to create before anything works.
    -->
    <Border DockPanel.Dock="Left"
            Width="248"
            IsVisible="{Binding IsNavigationVisible}"
            Background="{DynamicResource LinewiseSurface}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">

        <DockPanel DockPanel.Dock="Top" Margin="16,14,10,8" LastChildFill="True">
          <!-- An icon rather than a row in the list. Collapsing a panel is a thing you do
               to the panel, so it lives on the panel rather than among the places you can
               navigate to. -->
          <Button DockPanel.Dock="Right"
                  Classes="icon"
                  Content="⟨"
                  VerticalAlignment="Top"
                  ToolTip.Tip="{x:Static res:Strings.HideNavigation}"
                  Command="{Binding ToggleNavigationCommand}" />
          <StackPanel Spacing="2">
            <TextBlock Text="{x:Static res:Strings.ProductName}"
                       FontSize="17"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding Summary.StatusLabel}"
                       Classes="caption"
                       IsVisible="{Binding HasRoster}" />
          </StackPanel>
        </DockPanel>

        <!--
          One settings button rather than three toggles. Light or dark, whether the warnings
          panel is shown and whether this sidebar is are all the same kind of thing — how the
          window is arranged — and none of them belonged in a list beside the places you can
          navigate to.

          A flyout rather than a window: it dismisses by clicking away, so the one thing that
          opens over the roster cannot strand anybody.
        -->
        <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,14" Spacing="6">
          <Button Classes="nav" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="⚙" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static res:Strings.Settings}" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="RightEdgeAlignedBottom">
                <StackPanel MinWidth="280" MaxWidth="300" Spacing="2">
                  <TextBlock Text="{x:Static res:Strings.SettingsHeading}"
                             Classes="sectionHeading"
                             Margin="4,2,0,6" />

                  <ToggleSwitch Content="{x:Static res:Strings.SettingsDarkTheme}"
                                IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />

                  <!-- Showing and hiding the two panels is not here. Collapsing a panel is
                       something you do to the panel, and the chevron on it is both quicker
                       to reach and obvious without opening anything. -->

                  <TextBlock Text="{x:Static res:Strings.SettingsPrintHeading}"
                             Classes="sectionHeading"
                             Margin="4,12,0,4" />

                  <!-- Every one of these has been stored and honoured by the printer since
                       phase 4, and none of them could be changed without editing the
                       database by hand. -->
                  <StackPanel Spacing="6" IsVisible="{Binding PrintSettings, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBox Text="{Binding PrintSettings.CompanyName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Watermark="{x:Static res:Strings.SettingsCompanyName}" />

                    <TextBlock Text="{x:Static res:Strings.SettingsPaperSize}" Classes="caption" />
                    <ComboBox ItemsSource="{Binding PrintSettings.PaperSizes}"
                              SelectedItem="{Binding PrintSettings.PaperSize, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />

                    <TextBlock Text="{x:Static res:Strings.SettingsOrientation}" Classes="caption" />
                    <ComboBox ItemsSource="{Binding PrintSettings.Orientations}"
                              SelectedItem="{Binding PrintSettings.Orientation, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />

                    <TextBlock Text="{x:Static res:Strings.SettingsFontSize}" Classes="caption" />
                    <NumericUpDown Value="{Binding PrintSettings.BaseFontPoints, Mode=TwoWay}"
                                   Minimum="8"
                                   Maximum="36"
                                   Increment="1"
                                   FormatString="0"
                                   HorizontalAlignment="Stretch" />
                    <TextBlock Text="{x:Static res:Strings.SettingsFontSizeHint}"
                               Classes="caption"
                               TextWrapping="Wrap" />

                    <ToggleSwitch Content="{x:Static res:Strings.SettingsAccentColours}"
                                  IsChecked="{Binding PrintSettings.UseAccentColours, Mode=TwoWay}" />
                    <TextBlock Text="{x:Static res:Strings.SettingsAccentColoursHint}"
                               Classes="caption"
                               TextWrapping="Wrap" />
                  </StackPanel>

                  <TextBlock Text="{Binding Version}"
                             Classes="caption"
                             Margin="4,12,0,0"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <ScrollViewer>
          <StackPanel Margin="12,4,12,12" Spacing="4">

            <Button Content="{x:Static res:Strings.NavDashboard}"
                    Classes="nav"
                    Command="{Binding ShowDashboardCommand}" />

            <Button Content="{x:Static res:Strings.NavRosterView}"
                    Classes="nav"
                    Command="{Binding ShowRosterCommand}"
                    IsEnabled="{Binding HasRoster}" />

            <TextBlock Text="{x:Static res:Strings.NavActions}" Classes="sectionHeading" Margin="4,12,0,2" />

            <!-- Straight through the first time. Once a week exists, generating again
                 rebuilds something somebody has already looked at, so it says so first.

                 A flyout rather than a dialog: clicking away is the cancel, and this
                 application has twice shipped a window somebody could not leave. -->
            <Button Content="{x:Static res:Strings.GenerateRoster}"
                    Classes="primary nav"
                    IsEnabled="{Binding !IsBusy}"
                    IsVisible="{Binding !WouldRegenerate}"
                    Command="{Binding GenerateCommand}" />

            <Button Content="{x:Static res:Strings.GenerateRoster}"
                    Classes="primary nav"
                    IsEnabled="{Binding !IsBusy}"
                    IsVisible="{Binding WouldRegenerate}">
              <Button.Flyout>
                <Flyout Placement="RightEdgeAlignedTop">
                  <StackPanel MinWidth="280" MaxWidth="300" Spacing="8">
                    <TextBlock Text="{x:Static res:Strings.RegenerateHeading}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Static res:Strings.RegenerateExplains}"
                               Classes="caption"
                               TextWrapping="Wrap" />
                    <Button Content="{x:Static res:Strings.RegenerateConfirm}"
                            Classes="primary"
                            HorizontalAlignment="Right"
                            Command="{Binding GenerateCommand}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>

            <Button Content="{x:Static res:Strings.Print}"
                    Classes="nav"
                    Command="{Binding PrintCommand}"
                    IsEnabled="{Binding !IsBusy}" />

            <TextBlock Text="{x:Static res:Strings.NavSetUp}" Classes="sectionHeading" Margin="4,12,0,2" />

            <Button Content="{x:Static res:Strings.People}"
                    Classes="nav"
                    Command="{Binding ShowPeopleCommand}"
                    IsEnabled="{Binding !IsBusy}" />

            <Button Content="{x:Static res:Strings.Import}"
                    Classes="nav"
                    Command="{Binding ImportSheetCommand}"
                    IsEnabled="{Binding !IsBusy}" />

            <!-- The lines themselves, listed rather than hidden behind a button. On a first
                 run this is the empty list that explains why the grid has nothing in it. -->
            <DockPanel Margin="4,12,0,2" LastChildFill="False">
              <TextBlock DockPanel.Dock="Left"
                         Text="{x:Static res:Strings.NavLines}"
                         Classes="sectionHeading"
                         VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="{x:Static res:Strings.NoLinesSidebar}"
                       Classes="caption"
                       Margin="4,2,0,4"
                       IsVisible="{Binding !HasLines}" />

            <ItemsControl ItemsSource="{Binding ConfiguredLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SidebarLineViewModel">
                  <!-- A button, because the lines in this list are the obvious place
                       somebody goes to change one. It was a label for four phases and
                       clicking it did nothing, which is its own kind of wrong. -->
                  <Button Classes="quiet"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Padding="8,6"
                          Margin="0,0,0,4"
                          Background="{DynamicResource LinewiseSurfaceAlt}"
                          ToolTip.Tip="{Binding EditTip}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetUpLinesCommand}">
                    <DockPanel LastChildFill="True">
                      <Border DockPanel.Dock="Left"
                              Width="3"
                              CornerRadius="2"
                              Margin="0,0,8,0"
                              Background="{Binding AccentColour}" />
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}" Classes="caption" />
                        <TextBlock Text="{Binding Description}"
                                   Classes="caption"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasDescription}" />
                      </StackPanel>
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="{x:Static res:Strings.AddLineShort}"
                    Classes="nav"
                    Command="{Binding SetUpLinesCommand}"
                    IsEnabled="{Binding !IsBusy}" />

            <TextBlock Text="{x:Static res:Strings.Working}"
                       Classes="subtitle"
                       IsVisible="{Binding IsBusy}"
                       Margin="4,8,0,0" />

          </StackPanel>
        </ScrollViewer>

      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Left"
            IsVisible="{Binding !IsNavigationVisible}"
            Background="{DynamicResource LinewiseSurface}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="0,0,1,0"
            Padding="6,10">
      <Button Content="⟩"
              Classes="icon"
              VerticalAlignment="Top"
              ToolTip.Tip="{x:Static res:Strings.ShowNavigation}"
              Command="{Binding ToggleNavigationCommand}" />
    </Border>

    <!-- Status bar. State, counts, and the build, which is the first thing to ask for when
         somebody reports a fault. -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource LinewiseSurface}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="0,1,0,0"
            Padding="16,7">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left"
                   Text="{Binding Summary.CountsLabel}"
                   IsVisible="{Binding HasRoster}"
                   Classes="subtitle"
                   VerticalAlignment="Center" />
        <TextBlock DockPanel.Dock="Left"
                   Text="{Binding Status}"
                   IsVisible="{Binding !HasRoster}"
                   Classes="subtitle"
                   VerticalAlignment="Center" />

        <TextBlock DockPanel.Dock="Right"
                   Text="{Binding Summary.StatusLabel}"
                   IsVisible="{Binding HasRoster}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Warnings. Always visible when there are any, never behind a tab: a line that cannot
         run is not something to go looking for. -->
    <Border DockPanel.Dock="Right"
            Width="340"
            IsVisible="{Binding AreWarningsVisible}"
            IsEnabled="True"
            Background="{DynamicResource LinewiseSurface}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="1,0,0,0">
      <DockPanel LastChildFill="True">
        <DockPanel DockPanel.Dock="Top" Margin="16,14,10,8" LastChildFill="True">
          <!-- The same icon the sidebar carries, on the other side. Both panels are
               collapsed the same way, from the panel itself. -->
          <Button DockPanel.Dock="Right"
                  Classes="icon"
                  Content="⟩"
                  VerticalAlignment="Top"
                  ToolTip.Tip="{x:Static res:Strings.HideWarnings}"
                  Command="{Binding ToggleWarningsCommand}" />
          <StackPanel Spacing="2">
            <TextBlock Text="{x:Static res:Strings.WarningsHeading}" Classes="sectionHeading" />
            <TextBlock Text="{Binding Summary.WarningsLabel}" FontSize="14" FontWeight="SemiBold" />
          </StackPanel>
        </DockPanel>

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding WarningSections}" Margin="12,0,12,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WarningSectionViewModel">

                <!-- Errors open, notices shut. A week where thirty people are spare raises a
                     hundred and thirty notices that are all true and none of them urgent,
                     and they should not sit between the manager and the rows that matter. -->
                <Expander IsExpanded="{Binding IsExpanded}"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,0,6">
                  <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="severity" Classes.error="{Binding IsError}">
                        <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Text="{Binding RowsLabel}"
                                 Classes="caption"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Expander.Header>

                  <!-- One line per kind per day, not a card. The count carries what the
                       other nineteen rows would have said. -->
                  <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WarningGroupViewModel">
                        <Border BorderBrush="{DynamicResource LinewiseBorderSubtle}"
                                BorderThickness="0,0,0,1"
                                Padding="2,6">
                          <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Context}"
                                         Classes="caption"
                                         VerticalAlignment="Center" />
                              <Border Classes="severity"
                                      IsVisible="{Binding IsGrouped}"
                                      Background="{DynamicResource LinewiseChip}">
                                <TextBlock Text="{Binding CountLabel}" FontSize="10" FontWeight="SemiBold" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Message}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource LinewiseInk}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!--
      The dashboard. What is set up, what is imported, and what state the week is in.
      Shown instead of the grid, because somebody opening this on a Monday wants to know
      whether the sheet is in before they want to read a hundred and forty names.
    -->
    <ScrollViewer IsVisible="{Binding !IsShowingRoster}">
      <StackPanel Margin="24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

        <StackPanel Spacing="2">
          <TextBlock Text="{x:Static res:Strings.DashboardHeading}" Classes="sectionHeading" />
          <TextBlock Text="{Binding Dashboard.WeekLabel}" Classes="title" />
        </StackPanel>

        <!-- The one thing worth doing next. A dashboard listing everything equally is one
             somebody has to read; this says what is missing. -->
        <Border Classes="card" Padding="16">
          <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding Dashboard.NextStep}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button DockPanel.Dock="Right"
                    Content="{x:Static res:Strings.OpenRoster}"
                    Classes="quiet"
                    IsVisible="{Binding HasRoster}"
                    Command="{Binding ShowRosterCommand}" />
          </DockPanel>
        </Border>

        <!--
          What needs deciding, before how many of everything there is. This screen was five
          true statements about counts, none of which told the manager what to do next,
          which is the only question worth opening an overview to answer.
        -->
        <Border Classes="card"
                Padding="16"
                IsVisible="{Binding Dashboard.HasProblems}"
                BorderBrush="{DynamicResource LinewiseBorderStrong}"
                BorderThickness="1">
          <StackPanel Spacing="8">
            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left"
                         Text="{x:Static res:Strings.DashboardNeedsAttention}"
                         Classes="sectionHeading"
                         VerticalAlignment="Center" />
              <Button DockPanel.Dock="Right"
                      Content="{x:Static res:Strings.OpenRoster}"
                      Classes="primary"
                      IsVisible="{Binding HasRoster}"
                      Command="{Binding ShowRosterCommand}" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Dashboard.TopProblems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WarningGroupViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                    <TextBlock Text="{Binding Context}"
                               Classes="caption"
                               MinWidth="150"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Message}"
                               FontSize="12.5"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Dashboard.MoreProblemsLabel}"
                       Classes="caption"
                       IsVisible="{Binding Dashboard.HasMoreProblems}" />
          </StackPanel>
        </Border>

        <!-- A week with nothing wrong is the outcome, and saying so is better than a screen
             that only ever speaks up about problems. -->
        <Border Classes="card" Padding="16" IsVisible="{Binding Dashboard.IsAllWell}">
          <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="{x:Static res:Strings.DashboardAllWell}"
                       FontSize="14"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button DockPanel.Dock="Right"
                    Content="{x:Static res:Strings.OpenRoster}"
                    Classes="quiet"
                    Command="{Binding ShowRosterCommand}" />
          </DockPanel>
        </Border>

        <UniformGrid Columns="2" >
          <Border Classes="card" Padding="16" Margin="0,0,8,8">
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:Strings.NavLines}" Classes="sectionHeading" />
              <TextBlock Text="{Binding Dashboard.LinesLabel}" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="16" Margin="8,0,0,8">
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:Strings.WorkforceHeading}" Classes="sectionHeading" />
              <TextBlock Text="{Binding Dashboard.PeopleLabel}" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="16" Margin="0,8,8,0">
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:Strings.Import}" Classes="sectionHeading" />
              <TextBlock Text="{Binding Dashboard.AvailabilityLabel}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="16" Margin="8,8,0,0">
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:Strings.NavRosterView}" Classes="sectionHeading" />
              <TextBlock Text="{Binding Dashboard.RosterLabel}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Summary.WarningsLabel}"
                         Classes="caption"
                         IsVisible="{Binding HasRoster}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- Said once, plainly, because the previous version of this screen implied the
             opposite every week. -->
        <TextBlock Text="{x:Static res:Strings.DashboardSetupNote}"
                   Classes="subtitle"
                   TextWrapping="Wrap" />

        <!-- Guidance, only for a factory that does not exist yet. Once there are lines and
             people it goes away and does not come back. -->
        <Border Classes="card" Padding="20" IsVisible="{Binding IsFirstRun}">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Static res:Strings.GettingStartedHeading}" Classes="sectionHeading" />
            <TextBlock Text="{x:Static res:Strings.GettingStartedLines}" Classes="subtitle" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static res:Strings.GettingStartedImport}" Classes="subtitle" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static res:Strings.GettingStartedGenerate}" Classes="subtitle" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <views:RosterGridView DataContext="{Binding Grid}"
                          IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsShowingRoster}" />

  </DockPanel>

</Window>
