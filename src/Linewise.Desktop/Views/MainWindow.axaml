<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Linewise.Desktop.ViewModels"
        xmlns:views="using:Linewise.Desktop.Views"
        xmlns:res="using:Linewise.Desktop.Resources"
        mc:Ignorable="d"
        d:DesignWidth="1360" d:DesignHeight="820"
        x:Class="Linewise.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1360" Height="820"
        MinWidth="960" MinHeight="620"
        Background="{DynamicResource LinewiseSurfaceAlt}"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- Severity is carried by the word inside the badge. The border weight only makes an
         error findable at a glance; it is never the thing that says which it is. -->
    <Style Selector="Border.severity">
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseBorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="Border.severity.error">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseInk}" />
    </Style>

    <Style Selector="Border.severity.error > TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource LinewiseSurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!--
      Navigation down the side rather than a row of buttons across the top. A row gives
      every action the same weight and no grouping, so "generate this week" and "configure
      the factory" sit beside each other looking equally routine. Down the side there is
      room to separate what you do weekly from what you set up once, and room for the lines
      themselves, which are the thing a first run has to create before anything works.
    -->
    <Border DockPanel.Dock="Left"
            Width="248"
            IsVisible="{Binding IsNavigationVisible}"
            Background="{DynamicResource LinewiseSurface}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8" Spacing="2">
          <TextBlock Text="{x:Static res:Strings.ProductName}"
                     FontSize="17"
                     FontWeight="Bold" />
          <TextBlock Text="{Binding Summary.StatusLabel}"
                     Classes="caption"
                     IsVisible="{Binding HasRoster}" />
        </StackPanel>

        <!-- Appearance sits at the bottom, away from the things that change the roster. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,14" Spacing="6">
          <TextBlock Text="{x:Static res:Strings.NavAppearance}"
                     Classes="sectionHeading"
                     Margin="4,0,0,0" />
          <Button Content="{x:Static res:Strings.ToggleTheme}"
                  Classes="nav"
                  Command="{Binding ToggleThemeCommand}" />
          <Button Content="{x:Static res:Strings.ShowWarnings}"
                  Classes="nav"
                  Command="{Binding ToggleWarningsCommand}" />
          <Button Content="{x:Static res:Strings.HideNavigation}"
                  Classes="nav"
                  Command="{Binding ToggleNavigationCommand}" />
          <TextBlock Text="{Binding Version}" Classes="caption" Margin="4,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer>
          <StackPanel Margin="12,4,12,12" Spacing="4">

            <TextBlock Text="{x:Static res:Strings.NavActions}" Classes="sectionHeading" Margin="4,6,0,2" />

            <Button Content="{x:Static res:Strings.GenerateRoster}"
                    Classes="primary nav"
                    Command="{Binding GenerateCommand}"
                    IsEnabled="{Binding !IsBusy}" />

            <Button Content="{x:Static res:Strings.Print}"
                    Classes="nav"
                    Command="{Binding PrintCommand}"
                    IsEnabled="{Binding !IsBusy}" />

            <TextBlock Text="{x:Static res:Strings.NavSetUp}" Classes="sectionHeading" Margin="4,12,0,2" />

            <Button Content="{x:Static res:Strings.Import}"
                    Classes="nav"
                    Command="{Binding ImportSheetCommand}"
                    IsEnabled="{Binding !IsBusy}" />

            <!-- The lines themselves, listed rather than hidden behind a button. On a first
                 run this is the empty list that explains why the grid has nothing in it. -->
            <DockPanel Margin="4,12,0,2" LastChildFill="False">
              <TextBlock DockPanel.Dock="Left"
                         Text="{x:Static res:Strings.NavLines}"
                         Classes="sectionHeading"
                         VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="{x:Static res:Strings.NoLinesSidebar}"
                       Classes="caption"
                       Margin="4,2,0,4"
                       IsVisible="{Binding !HasLines}" />

            <ItemsControl ItemsSource="{Binding ConfiguredLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SidebarLineViewModel">
                  <Border Background="{DynamicResource LinewiseSurfaceAlt}"
                          CornerRadius="{StaticResource RadiusSm}"
                          Padding="8,6"
                          Margin="0,0,0,4">
                    <DockPanel LastChildFill="True">
                      <Border DockPanel.Dock="Left"
                              Width="3"
                              CornerRadius="2"
                              Margin="0,0,8,0"
                              Background="{Binding AccentColour}" />
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}" Classes="caption" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="{x:Static res:Strings.AddLineShort}"
                    Classes="nav"
                    Command="{Binding SetUpLinesCommand}"
                    IsEnabled="{Binding !IsBusy}" />

            <TextBlock Text="{x:Static res:Strings.Working}"
                       Classes="subtitle"
                       IsVisible="{Binding IsBusy}"
                       Margin="4,8,0,0" />

          </StackPanel>
        </ScrollViewer>

      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Left"
            IsVisible="{Binding !IsNavigationVisible}"
            Background="{DynamicResource LinewiseSurface}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="0,0,1,0"
            Padding="6,10">
      <Button Content="{x:Static res:Strings.ShowNavigation}"
              Classes="quiet"
              VerticalAlignment="Top"
              Command="{Binding ToggleNavigationCommand}" />
    </Border>

    <!-- Status bar. State, counts, and the build, which is the first thing to ask for when
         somebody reports a fault. -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource LinewiseSurface}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="0,1,0,0"
            Padding="16,7">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left"
                   Text="{Binding Summary.CountsLabel}"
                   IsVisible="{Binding HasRoster}"
                   Classes="subtitle"
                   VerticalAlignment="Center" />
        <TextBlock DockPanel.Dock="Left"
                   Text="{Binding Status}"
                   IsVisible="{Binding !HasRoster}"
                   Classes="subtitle"
                   VerticalAlignment="Center" />

        <TextBlock DockPanel.Dock="Right"
                   Text="{Binding Summary.StatusLabel}"
                   IsVisible="{Binding HasRoster}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Warnings. Always visible when there are any, never behind a tab: a line that cannot
         run is not something to go looking for. -->
    <Border DockPanel.Dock="Right"
            Width="340"
            IsVisible="{Binding AreWarningsVisible}"
            Background="{DynamicResource LinewiseSurface}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="1,0,0,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="16,14,16,8">
          <TextBlock Text="{x:Static res:Strings.WarningsHeading}" Classes="sectionHeading" />
          <TextBlock Text="{Binding Summary.WarningsLabel}" FontSize="14" FontWeight="SemiBold" />
        </StackPanel>

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding WarningGroups}" Margin="12,0,12,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WarningGroupViewModel">
                <Border Classes="card" Padding="10" Margin="0,0,0,6">
                  <StackPanel Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Classes="severity" Classes.error="{Binding IsError}">
                        <TextBlock Text="{Binding SeverityLabel}" FontSize="10" />
                      </Border>
                      <TextBlock Text="{Binding Context}"
                                 Classes="caption"
                                 VerticalAlignment="Center" />
                      <Border Classes="severity"
                              IsVisible="{Binding IsGrouped}"
                              Background="{DynamicResource LinewiseChip}">
                        <TextBlock Text="{Binding CountLabel}" FontSize="10" FontWeight="SemiBold" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Message}"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource LinewiseInk}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Nothing stored yet. A first run has an empty database, which is normal rather than
         a fault, so it says what to do next instead of drawing an empty grid. -->
    <Border IsVisible="{Binding !HasRoster}" Padding="24">
      <Border Classes="card"
              Padding="32"
              MaxWidth="520"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="{x:Static res:Strings.ProductName}"
                     FontSize="26"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Status}"
                     Classes="subtitle"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
          <Border Height="1" Background="{DynamicResource LinewiseBorderSubtle}" />
          <TextBlock Text="{x:Static res:Strings.GettingStartedHeading}" Classes="sectionHeading" />
          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static res:Strings.GettingStartedImport}" Classes="subtitle" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static res:Strings.GettingStartedLines}" Classes="subtitle" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static res:Strings.GettingStartedGenerate}" Classes="subtitle" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <views:RosterGridView DataContext="{Binding Grid}"
                          IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).HasRoster}" />

  </DockPanel>

</Window>
