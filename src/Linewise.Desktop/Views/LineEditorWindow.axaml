<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Linewise.Desktop.ViewModels"
        xmlns:res="using:Linewise.Desktop.Resources"
        mc:Ignorable="d"
        d:DesignWidth="620" d:DesignHeight="560"
        x:Class="Linewise.Desktop.Views.LineEditorWindow"
        x:DataType="vm:LineEditorViewModel"
        Title="{x:Static res:Strings.Lines}"
        Width="620" Height="560"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource LinewiseSurfaceAlt}">

  <DockPanel LastChildFill="True" Margin="16">

    <TextBlock DockPanel.Dock="Top"
               Text="{x:Static res:Strings.Lines}"
               Classes="title"
               Margin="0,0,0,12" />

    <!-- Adding. Name and headcount are the only two things a line cannot do without. -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource LinewiseSurfaceRaised}"
            BorderBrush="{DynamicResource LinewiseBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14"
            Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding NewLineName}"
                 Watermark="{x:Static res:Strings.LineName}"
                 Width="220" />
        <NumericUpDown Value="{Binding NewLineHeadcount}"
                       Minimum="1"
                       Maximum="200"
                       Increment="1"
                       FormatString="0"
                       Width="120" />
        <Button Content="{x:Static res:Strings.AddLine}"
                Classes="primary"
                Command="{Binding AddCommand}"
                IsDefault="True" />
      </StackPanel>
    </Border>

    <!-- Footer -->
    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,12,0,0">
      <TextBlock DockPanel.Dock="Left"
                 Text="{Binding Status}"
                 Classes="subtitle"
                 VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right"
              Content="{x:Static res:Strings.Close}"
              Classes="quiet"
              Click="OnClose"
              Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right"
              Content="{x:Static res:Strings.SaveLines}"
              Command="{Binding SaveCommand}"
              IsEnabled="{Binding HasLines}" />

      <!-- Beside the button, the same as the people screen. A message saying a save
           happened is not an answer to "is what I am looking at saved", and it is the
           second one somebody wants before they close the window. -->
      <Border DockPanel.Dock="Right" Classes="severity" Margin="0,0,8,0"
              IsVisible="{Binding IsSaved}">
        <TextBlock Text="{x:Static res:Strings.SavedIndicator}" FontSize="11" FontWeight="SemiBold" />
      </Border>

      <Border DockPanel.Dock="Right" Classes="severity error" Margin="0,0,8,0"
              IsVisible="{Binding HasUnsavedChanges}">
        <TextBlock Text="{x:Static res:Strings.UnsavedIndicator}" FontSize="11" FontWeight="SemiBold" />
      </Border>
    </DockPanel>

    <TextBlock Text="{x:Static res:Strings.NoLinesYet}"
               IsVisible="{Binding !HasLines}"
               Classes="subtitle"
               TextWrapping="Wrap"
               VerticalAlignment="Top" />

    <ScrollViewer IsVisible="{Binding HasLines}">
      <ItemsControl ItemsSource="{Binding Lines}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:EditableLineViewModel">
            <Border Background="{DynamicResource LinewiseSurfaceRaised}"
                    BorderBrush="{DynamicResource LinewiseBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,6">
              <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <!-- The line's colour, beside its name and never instead of it. -->
                <Border Width="4"
                        CornerRadius="2"
                        Background="{Binding AccentColour}" />
                <!-- On lost focus, not on every keystroke. A per-keystroke binding writes
                     the value back into the control it came from, which is a caret reset
                     waiting for the first property that does not round trip exactly. -->
                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Width="240" />
                <NumericUpDown Value="{Binding RequiredHeadcount}"
                               Minimum="1"
                               Maximum="200"
                               Increment="1"
                               FormatString="0"
                               Width="110" />
                <NumericUpDown Value="{Binding RequiredOperatingAssistants}"
                               Minimum="0"
                               Maximum="50"
                               Increment="1"
                               FormatString="0"
                               Width="110"
                               ToolTip.Tip="{x:Static res:Strings.OperatingAssistantsNeeded}" />
                <NumericUpDown Value="{Binding DisplayOrder}"
                               Minimum="1"
                               Maximum="999"
                               Increment="1"
                               FormatString="0"
                               Width="90" />
              </StackPanel>

                <!-- What the line is for, and how it is arranged. Both optional, and both
                     on lost focus for the same reason the name is. -->
                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Watermark="{x:Static res:Strings.LineDescription}"
                         MaxLength="500"
                         HorizontalAlignment="Stretch" />

                <TextBox Text="{Binding LayoutNotes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Watermark="{x:Static res:Strings.LineLayoutNotes}"
                         MaxLength="2000"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="54"
                         HorizontalAlignment="Stretch" />

                <TextBlock Text="{x:Static res:Strings.LineLayoutNotesHint}"
                           Classes="caption"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>

</Window>
