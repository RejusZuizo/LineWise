<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Linewise.Desktop.ViewModels"
        xmlns:res="using:Linewise.Desktop.Resources"
        mc:Ignorable="d"
        d:DesignWidth="680" d:DesignHeight="620"
        x:Class="Linewise.Desktop.Views.ImportWindow"
        x:DataType="vm:ImportViewModel"
        Title="{x:Static res:Strings.ImportTitle}"
        Width="680" Height="620"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource LinewiseSurfaceAlt}">

  <DockPanel LastChildFill="True" Margin="16">

    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <TextBlock Text="{x:Static res:Strings.ImportTitle}" Classes="title" />

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="{x:Static res:Strings.ChooseSheet}"
                Classes="quiet"
                Command="{Binding ChooseFileCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <TextBlock Text="{Binding FileName}" Classes="subtitle" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Counts before anything is written. This is the review step: the operator sees
           what the sheet says and only then decides. -->
      <TextBlock Text="{Binding Summary}"
                 IsVisible="{Binding HasParsed}"
                 FontSize="14"
                 FontWeight="SemiBold" />

      <TextBlock Text="{Binding Status}" Classes="subtitle" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Footer -->
    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right"
              Content="{x:Static res:Strings.Close}"
              Classes="quiet"
              Click="OnClose"
              Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right"
              Content="{x:Static res:Strings.ImportCommit}"
              Classes="primary"
              Command="{Binding CommitCommand}"
              IsEnabled="{Binding CanCommit}"
              IsDefault="True" />
    </DockPanel>

    <!-- Names the matcher could not settle. Never dropped silently: a dropped row is
         somebody who does not appear on the wall sheet. -->
    <DockPanel IsVisible="{Binding HasParsed}" Margin="0,12,0,0" LastChildFill="True">

      <StackPanel DockPanel.Dock="Top" Spacing="6">
        <DockPanel LastChildFill="False">
          <TextBlock DockPanel.Dock="Left"
                     Text="{x:Static res:Strings.ImportNeedingAttention}"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <Button DockPanel.Dock="Right"
                  Content="{x:Static res:Strings.ImportAddAllAsTemporary}"
                  Classes="quiet"
                  Command="{Binding AddAllAsTemporaryCommand}" />
        </DockPanel>

        <TextBlock Text="{Binding UnrecognisedCellCount, Converter={x:Static vm:Converters.UnrecognisedCells}}"
                   IsVisible="{Binding UnrecognisedCellCount}"
                   TextWrapping="Wrap"
                   Classes="subtitle" />
      </StackPanel>

      <ScrollViewer Margin="0,8,0,0">
        <ItemsControl ItemsSource="{Binding NeedingAttention}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:UnresolvedRowViewModel">
              <Border Background="{DynamicResource LinewiseSurfaceRaised}"
                      BorderBrush="{DynamicResource LinewiseBorder}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="10,7"
                      Margin="0,0,0,5">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <CheckBox IsChecked="{Binding AddAsTemporary}"
                            Content="{x:Static res:Strings.ImportAddAsTemporary}" />
                  <TextBlock Text="{Binding SheetName}"
                             VerticalAlignment="Center"
                             Width="260"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding RowIndex, Converter={x:Static vm:Converters.RowLabel}}"
                             VerticalAlignment="Center"
                             Classes="caption" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>

  </DockPanel>

</Window>
