<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="Linewise.Desktop.App"
             RequestedThemeVariant="Light">

  <!--
    Light by default and not following the system. The design document's reasoning holds: a
    roster on screen is compared against a sheet of white paper on a wall, and the screen
    should not be arguing with the printer. Dark is one button away for anybody working in
    an office where it matters more than the comparison does.
  -->

  <Application.Resources>
    <ResourceDictionary>

      <!--
        Spacing and shape. Named once, so density is a decision made in one place rather
        than a number typed forty times. A full week across every line has to fit without
        scrolling, which is what keeps these small.
      -->
      <x:Double x:Key="SpaceXs">4</x:Double>
      <x:Double x:Key="SpaceSm">8</x:Double>
      <x:Double x:Key="SpaceMd">12</x:Double>
      <x:Double x:Key="SpaceLg">16</x:Double>
      <x:Double x:Key="SpaceXl">24</x:Double>
      <CornerRadius x:Key="RadiusSm">4</CornerRadius>
      <CornerRadius x:Key="RadiusMd">6</CornerRadius>
      <CornerRadius x:Key="RadiusPill">10</CornerRadius>
      <x:Double x:Key="LineColumnWidth">180</x:Double>

      <ResourceDictionary.ThemeDictionaries>

        <!--
          Every key here is chrome: surfaces, lines, text. None of them carries a meaning on
          its own, which is the rule that lets the whole palette change without anything
          becoming unreadable. Meaning is carried by words, weight and position.
        -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="LinewiseSurface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="LinewiseSurfaceAlt" Color="#F4F6F8" />
          <SolidColorBrush x:Key="LinewiseSurfaceRaised" Color="#FFFFFF" />
          <SolidColorBrush x:Key="LinewiseSurfaceSunken" Color="#EDF0F3" />
          <SolidColorBrush x:Key="LinewiseBorder" Color="#DBE0E5" />
          <SolidColorBrush x:Key="LinewiseBorderSubtle" Color="#EAEDF0" />
          <SolidColorBrush x:Key="LinewiseBorderStrong" Color="#7C858E" />
          <SolidColorBrush x:Key="LinewiseInk" Color="#1F262B" />
          <SolidColorBrush x:Key="LinewiseInkMuted" Color="#5B666F" />
          <SolidColorBrush x:Key="LinewiseInkFaint" Color="#8B959D" />
          <SolidColorBrush x:Key="LinewiseAccent" Color="#1F6FEB" />
          <SolidColorBrush x:Key="LinewiseAccentInk" Color="#FFFFFF" />
          <SolidColorBrush x:Key="LinewiseChip" Color="#F0F3F6" />
          <SolidColorBrush x:Key="LinewiseLeaderFill" Color="#E3EDFB" />
          <SolidColorBrush x:Key="LinewiseLeaderInk" Color="#14448F" />
          <SolidColorBrush x:Key="LinewiseAssistantFill" Color="#E6F1E9" />
          <SolidColorBrush x:Key="LinewiseAssistantInk" Color="#1E5B34" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="LinewiseSurface" Color="#171A1D" />
          <SolidColorBrush x:Key="LinewiseSurfaceAlt" Color="#1E2226" />
          <SolidColorBrush x:Key="LinewiseSurfaceRaised" Color="#22272B" />
          <SolidColorBrush x:Key="LinewiseSurfaceSunken" Color="#121517" />
          <SolidColorBrush x:Key="LinewiseBorder" Color="#333A40" />
          <SolidColorBrush x:Key="LinewiseBorderSubtle" Color="#282E33" />
          <SolidColorBrush x:Key="LinewiseBorderStrong" Color="#7E8994" />
          <SolidColorBrush x:Key="LinewiseInk" Color="#E7EBEE" />
          <SolidColorBrush x:Key="LinewiseInkMuted" Color="#A3ADB6" />
          <SolidColorBrush x:Key="LinewiseInkFaint" Color="#7A848D" />
          <SolidColorBrush x:Key="LinewiseAccent" Color="#4C93FF" />
          <SolidColorBrush x:Key="LinewiseAccentInk" Color="#0E1114" />
          <SolidColorBrush x:Key="LinewiseChip" Color="#2A3036" />
          <SolidColorBrush x:Key="LinewiseLeaderFill" Color="#16283F" />
          <SolidColorBrush x:Key="LinewiseLeaderInk" Color="#9CC4FF" />
          <SolidColorBrush x:Key="LinewiseAssistantFill" Color="#17301F" />
          <SolidColorBrush x:Key="LinewiseAssistantInk" Color="#8FD3A6" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <sty:FluentAvaloniaTheme PreferSystemTheme="False" />

    <!-- Shared control styling. Kept here rather than per window, so two screens cannot
         drift into looking like two products. -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource LinewiseSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource LinewiseInk}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="MinHeight" Value="32" />
    </Style>

    <!-- One primary action per screen. The rest are quiet, so the eye lands on the thing
         the operator came to do rather than on whichever button is furthest left. -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource LinewiseAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource LinewiseAccentInk}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LinewiseAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource LinewiseAccentInk}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>

    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource LinewiseBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Sidebar buttons. Full width and left aligned, so the list reads as a list rather
         than as a row of controls that happen to be stacked. -->
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LinewiseSurfaceSunken}" />
    </Style>

    <Style Selector="Button.nav.primary">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style Selector="NumericUpDown">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="MinHeight" Value="32" />
    </Style>

    <!-- Typography. Three sizes and three weights across the whole application; a screen
         that needs a fourth usually needs rearranging instead. -->
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource LinewiseInk}" />
    </Style>

    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource LinewiseInkMuted}" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource LinewiseInkFaint}" />
    </Style>

    <Style Selector="TextBlock.sectionHeading">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource LinewiseInkMuted}" />
      <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
  </Application.Styles>

</Application>
