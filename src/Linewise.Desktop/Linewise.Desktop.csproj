<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Follows Infrastructure, which is Windows specific because of DPAPI. ADR 0006. -->
    <TargetFramework>net8.0-windows</TargetFramework>

    <!--
      RuntimeIdentifiers, plural, and deliberately not RuntimeIdentifier.

      The plural form tells restore to produce a win-x64 target so that publishing for it
      later needs no second restore. The singular form would additionally make every Release
      build a win-x64 build, and then an ordinary `dotnet build -c Release` demands an asset
      a plain `dotnet restore` never produced. That is NETSDK1047, it broke CI on both
      platforms, and it still built here because this machine's obj folder was holding
      assets from a publish run by hand ten minutes earlier.

      The identifier goes on the publish command, where it belongs. Self contained too: the
      factory PC is a machine nobody here administers, and "install the .NET runtime first"
      is a support call rather than an instruction.
    -->

    <!--
      Trimming is off. Avalonia resolves controls and this application resolves services
      through reflection, and a trimmed build fails at the moment somebody opens a screen
      rather than at build time. Seventy megabytes is not worth that.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>

    <AssemblyName>Linewise</AssemblyName>
    <Product>Linewise</Product>
    <Company>Linewise</Company>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Linewise.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Compiled bindings by default. A binding typo becomes a build error rather than a
         silently empty cell in a roster somebody is about to print. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Linewise.Domain\Linewise.Domain.csproj" />
    <ProjectReference Include="..\Linewise.Application\Linewise.Application.csproj" />
    <ProjectReference Include="..\Linewise.Infrastructure\Linewise.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <!-- The developer tools window, F12. Debug only: it is a live view of the visual tree
         and the data behind it, which on this product means employee names. -->
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
