<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Follows Infrastructure, which is Windows specific because of DPAPI. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Linewise.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Linewise.Domain\Linewise.Domain.csproj" />
    <ProjectReference Include="..\..\src\Linewise.Application\Linewise.Application.csproj" />
    <ProjectReference Include="..\..\src\Linewise.Infrastructure\Linewise.Infrastructure.csproj" />
    <!-- View models only. Nothing here constructs a control or needs a UI thread, which is
         the practical test of whether MVVM is being honoured. -->
    <ProjectReference Include="..\..\src\Linewise.Desktop\Linewise.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Used to generate .xlsx fixtures in memory. No spreadsheet is ever committed:
         a file from the factory would be personal data. -->
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
