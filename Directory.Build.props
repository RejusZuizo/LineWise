<Project>

  <!-- Applies to every project in the solution. Set language and quality rules once. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>en-GB</NeutralLanguage>
  </PropertyGroup>

  <!-- Reproducible restore. CI restores in locked mode, so an unexpected package
       version fails the build rather than silently entering a release. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!--
      RuntimeIdentifiers, plural, for every project rather than only the one that is
      published. Publishing the desktop application for win-x64 applies the identifier to
      everything it references, so a lock file without that target is one the publish has to
      rewrite — and an ordinary build then rewrites it back. The two fight, and a locked
      restore on CI is what notices.

      Plural, never singular. The singular form would make every Release build a win-x64
      build, and then `dotnet build -c Release` demands an asset a plain restore never
      produced. That is NETSDK1047. It broke CI on both platforms and still built here,
      because this machine had assets left over from a publish run by hand.

      This does not make the domain or the application layer Windows bound. It is a restore
      target, not a target framework; both stay on plain net8.0 and stay portable.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Linewise</Product>
    <Company>Linewise</Company>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Version. The prefix is the release being worked towards, not the last one shipped,
    so anything built from main says what it is rather than claiming to be the previous
    tag. The suffix comes off and the tag goes on when the phase completes.

    Below 1.0.0 these are phase completions rather than releases. 1.0.0 is reserved for
    a build that has produced a roster somebody actually worked to.
  -->
  <PropertyGroup>
    <VersionPrefix>0.7.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
  </PropertyGroup>

  <!--
    Deterministic output. The same source produces byte identical assemblies, and on CI
    the file paths baked into the symbols are normalised rather than recording whoever's
    machine happened to build it. That matters here for two reasons beyond tidiness: the
    paths would otherwise carry a developer's home directory into a shipped artefact, and
    a build that cannot be reproduced cannot be checked against the one that was signed.

    GitHub Actions sets CI, so this turns itself on there and stays off locally, where
    normalised paths would only make debugging harder.
  -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
